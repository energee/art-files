#!/bin/sh
# pre-push — run the same release metadata check CI runs (release-metadata.yml),
# so version/lockfile drift is caught locally before it reaches a PR.
# Activated by `npm install` via the package.json "prepare" script
# (git config core.hooksPath .githooks). See .agents/release-steward.md.

# ponytail: no origin/main (fresh clone, offline) = skip; CI still guards.
base=$(git merge-base HEAD origin/main 2>/dev/null) || exit 0
exec node scripts/check-release.mjs "$base"
