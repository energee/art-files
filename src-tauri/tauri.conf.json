{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Label Lab",
  "version": "0.1.128",
  "identifier": "com.labellab.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Label Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "fileAssociations": [
      {
        "ext": ["label"],
        "name": "Label Lab Project",
        "description": "Label Lab project file",
        "role": "Editor"
      }
    ],
    "shortDescription": "Create print-ready label artwork and white-ink plates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
