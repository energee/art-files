    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
