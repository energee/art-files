    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.0.0",
    "react-resizable-panels": "^4.12.2",
