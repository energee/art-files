{
  "name": "label-lab",
  "private": true,
  "version": "0.1.90",
  "type": "module",
  "description": "Label Lab: create print-ready label artwork and white-ink plates",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "desktop:dev": "tauri dev",
