    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "ag-psd": "^31.0.2",
    "happy-dom": "^20.11.6",
    "pngjs": "^7.0.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
