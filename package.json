{
  "name": "label-lab",
  "private": true,
  "version": "0.1.98",
  "type": "module",
  "description": "Label Lab: create print-ready label artwork and white-ink plates",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:release-config": "node scripts/configure-updater.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "vite preview",
    "strokecap": "vite --open /strokecap.html",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "generate": "tsx scripts/generate.ts",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
