{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/dev/*.ts",
    "scripts/*.{ts,mts,mjs}",
    "tests/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**",
    "scripts/**",
    "tests/**"
  ],
  "ignore": [
    "src/components/ui/**"
  ],
  "ignoreBinaries": [
    "pdftoppm"
  ],
  "ignoreDependencies": []
}
