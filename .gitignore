node_modules/
dist/
out/
*.tsbuildinfo
.DS_Store
.agents/worktrees/
# Agent scratch space: session state and git worktrees checked out inside the
# repo. Same reason as the line above — a worktree here is a second copy of
# the tree, which git would otherwise offer to commit into this one.
.claude/
# UI mockups an agent renders while working out a design. Throwaway by
# nature — the design that survives lands in the components, not here.
.agents/mockups/
src-tauri/tauri.release.generated.conf.json
# This repo uses npm (package-lock.json). pnpm files appear when someone runs
# pnpm here by habit; a second lockfile would drift from the real one.
pnpm-lock.yaml
pnpm-workspace.yaml
# Session memory from the `remember` agent plugin — local scratch. ESLint's
# flat config does not read this file, so eslint.config.js ignores it too.
.remember/
